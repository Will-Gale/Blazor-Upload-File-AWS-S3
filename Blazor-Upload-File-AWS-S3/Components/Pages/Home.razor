@code 
{

    [SupplyParameterFromForm(FormName = "savedocuments")]
    private InputModel Input { get; set; } = new();

    private string message = string.Empty;

    private string 

    private async Task SaveDocuments()
    {

        if (ValidateInputModel(Input))
        {

            DocumentsDTO dto = new()
                {
                    File1 = Input.File1,
                    File1Bytes = Input.File1Bytes,
                    File2 = Input.File2,
                    File2Bytes = Input.File2Bytes,
                    File3 = Input.File3,
                    File3Bytes = Input.File3Bytes,
                    File4 = Input.File4,
                    File4Bytes = Input.File4Bytes,
                };

            var saved = await DocumentManager.SaveDocuments(dto);

            if (saved.IsSuccess)
            {
                // Do something, either redirect or display a success modal.
            }

        }

        message = "You need to make sure you upload all 4 of the forms below...";
        return;

    }

    private bool ValidateInputModel(InputModel inputmodel)
    {
        if (inputmodel.File1 != null && inputmodel.File2 != null && inputmodel.File3 != null && inputmodel.File4 != null)
        {
            message = "";
            return true;
        }
        message = "You need to make sure you upload all 4 of the forms below...";
        return false;
    }

    private bool IsFileSafe(IBrowserFile file, int fileNum)
    {

        if (file is null)
        {
            SetFileError(fileNum, "Upload failed, please try again...");
            return false;
        }

        // Validate MIME type and file extension
        var allowedMimeTypes = new[] { "application/pdf", "image/jpeg", "image/png" };
        var allowedExtensions = new[] { ".pdf", ".jpg", ".jpeg", ".png" };

        var fileType = file.ContentType;
        var fileExtension = Path.GetExtension(file.Name).ToLower();

        if (!allowedMimeTypes.Contains(fileType) || !allowedExtensions.Contains(fileExtension))
        {
            SetFileError(fileNum, "Unsupported file type.");
            return false; // Reject unsupported files
        }

        // Validate file size (already limited by OpenReadStream)
        if (file.Size > 50 * 1024 * 1024)
        {
            SetFileError(fileNum, "File size exceeds the limit.");
            return false;
        }

        return true;

    }

    private void SetFileError(int fileNum, string errorMessage)
    {
        switch (fileNum)
        {
            case 1:
                Input.File1Error = errorMessage;
                break;
            case 2:
                Input.File2Error = errorMessage;
                break;
            case 3:
                Input.File3Error = errorMessage;
                break;
            case 4:
                Input.File4Error = errorMessage;
                break;
            default:
                break;
        }
    }

    private async Task OnChange(InputFileChangeEventArgs e, int filenum)
    {
        try
        {

            var file = e.File;

            // Reset error message
            switch (filenum)
            {
                case 1:
                    Input.File1Error = null;
                    Input.File1 = file; // Still store original reference
                    break;
                case 2:
                    Input.File2Error = null;
                    Input.File2 = file;
                    break;
                case 3:
                    Input.File3Error = null;
                    Input.File3 = file;
                    break;
                case 4:
                    Input.File4Error = null;
                    Input.File4 = file;
                    break;
            }

            if (file is null || !IsFileSafe(file, filenum))
            {
                return;
            }

            // ✅ Immediately store file in memory to avoid Blazor losing track of it
            using var fileStream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);

            memoryStream.Position = 0; // Reset position to start

            // Convert to Base64 for preview
            var fileBytes = memoryStream.ToArray();
            var objectUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(fileBytes)}";

            // ✅ Store the file as a byte array instead of relying on IBrowserFile
            switch (filenum)
            {
                case 1:
                    Input.FilePreview1 = objectUrl;
                    Input.File1Bytes = fileBytes;
                    break;
                case 2:
                    Input.FilePreview2 = objectUrl;
                    Input.File2Bytes = fileBytes;
                    break;
                case 3:
                    Input.FilePreview3 = objectUrl;
                    Input.File3Bytes = fileBytes;
                    break;
                case 4:
                    Input.FilePreview4 = objectUrl;
                    Input.File4Bytes = fileBytes;
                    break;
            }
            message = "";
        }
        catch (Exception ex)
        {
            SetFileError(filenum, $"Upload failed: {ex.Message}");
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "The Lender Package is required...")]
        public IBrowserFile? File1 { get; set; }
        public byte[]? File1Bytes { get; set; }
        public string? FilePreview1 { get; set; }
        public string? File1Error { get; set; }

        [Required(ErrorMessage = "The Appraisal is required...")]
        public IBrowserFile? File2 { get; set; }
        public byte[]? File2Bytes { get; set; }
        public string? FilePreview2 { get; set; }
        public string? File2Error { get; set; }

        [Required(ErrorMessage = "The Purview is required...")]
        public IBrowserFile? File3 { get; set; }
        public byte[]? File3Bytes { get; set; }
        public string? FilePreview3 { get; set; }
        public string? File3Error { get; set; }

        [Required(ErrorMessage = "The Notice of Assessment is required...")]
        public IBrowserFile? File4 { get; set; }
        public byte[]? File4Bytes { get; set; }
        public string? FilePreview4 { get; set; }
        public string? File4Error { get; set; }
    }

}   